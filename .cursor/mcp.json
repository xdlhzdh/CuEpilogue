      "type": "stdio"
    },
    "fetch": {
      "command": "/home/xdlhzdh/.local/bin/uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "cwd": "${currentProjectRoot}",
      "type": "stdio"
    }
  }
}