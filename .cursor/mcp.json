{
  "mcpServers": {
    "memorix": {
      "command": "npx",
      "args": [
        "memorix",
        "serve",
        "--global"
      ]
    },
    "code-review-graph": {
      "command": "/home/xdlhzdh/.local/bin/uvx",
      "args": [
        "code-review-graph",
